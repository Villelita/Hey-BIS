[Unit]
Description=Hey BIS Wake Word & Audio AI Service
After=network.target

[Service]
Type=simple
# Ajustar según el usuario del servidor (ej. pi, ubuntu, etc.)
User=pi
WorkingDirectory=/home/pi/Hey-BIS
ExecStart=/usr/bin/python3 /home/pi/Hey-BIS/service/server.py --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
